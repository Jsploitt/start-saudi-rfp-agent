# Optional. Leave it unset and the signed-in Claude Code session is used instead.
ANTHROPIC_API_KEY=sk-ant-...

# Only needed if the API rejects the key with "not scoped to a workspace".
# That came from the 0.1.x Agent SDK; the version this project uses does not need it.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# "live" (default), or "cached" to replay fixtures/cached-run.json with no network.
DEMO_MODE=live

# Let the researcher subagent search the web. Off by default: the demo has to run
# with no network, and the researcher is useful without it.
# ALLOW_WEB=1

# Server port, default 5173.
PORT=5173

# --- hosting ---

# Shared passcode for the whole deployment. Unset, one is generated and printed
# at boot, and it changes every restart. Set this before hosting.
ACCESS_PASSCODE=

# Signs the session cookie. Any long random string. Unset, a per-process key is
# used and every restart signs everyone out.
SESSION_SECRET=

# Where everything written at runtime lives: app.db, runs/, uploads/. On Railway
# this is the mounted volume. Unset, it falls back to the source tree.
DATA_DIR=/data

# Live sessions this process will carry at once. Each one is a Node parent plus a
# Claude subprocess, plus researcher and reviewer subprocesses during their
# windows, plus Chromium during export. Measure RSS before raising it.
MAX_CONCURRENT_RUNS=2

# In dev, hand everything that is not an API route or an artifact to Vite, so
# HMR works behind one origin. Unset in production: the built files in web/dist
# are served directly.
# VITE_DEV_URL=http://localhost:5174
